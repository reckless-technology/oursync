#!/bin/bash
# OurSync, the per-user half of the installation: the Drive remote, the union over it, the pin
# directory and the configuration file.
#
# This is separate from the package because none of it can be done at install time. A .deb installs
# once for the machine; a Drive remote, an OAuth token and a cache directory belong to a person, and
# on a shared machine each of them needs their own. So the package places the files and this is run
# once by each user.
#
# It is safe to re-run. It will not overwrite a configuration file that already exists, because
# that holds the generated control-port password, and it will not re-authorise a remote that
# already has the scope asked for.
set -u

PROG=${0##*/}
VERSION="@VERSION@"
case "$VERSION" in *@*) VERSION="0.0.0 (from source)" ;; esac

CONF="${OURSYNC_CONF:-$HOME/.config/oursync/oursync.conf}"
CONF_DIR=$(dirname -- "$CONF")

REMOTE="${REMOTE:-gdrive-own}"
UNION="${UNION:-drive-pinned}"
MOUNT="${MOUNT:-$HOME/Drive}"
PIN_DIR="${PIN_DIR:-$HOME/.local/share/oursync/pinned}"
CACHE_DIR="${CACHE_DIR:-$HOME/.cache/oursync}"
# Empty means "leave an existing remote's scope alone, and ask for drive when creating one". A
# re-run of setup - which install.sh does every time - must not put a Google consent screen in
# front of somebody who only reinstalled the scripts. Changing the scope is an explicit --scope.
SCOPE=""
CLIENT_SECRET=""
CLIENT_SECRET_GIVEN=no
FORCE_REAUTH=no

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
note() { printf '%s\n' "$*" >&2; }
rule() { printf '\n%s\n\n' "------------------------------------------------------------------------"; }

usage() {
    cat <<USAGE
$PROG - create or re-authorise OurSync's per-user configuration

  --scope drive|drive.readonly   what to ask Google for. A new remote asks for drive, which
                                 can write; an existing one keeps the scope it has unless
                                 this says otherwise, so a re-run never springs a consent
                                 screen on you
  --client-secret PATH           the Desktop app OAuth client JSON from Google Cloud. Without it,
                                 setup uses $CONF_DIR/client_secret.json if there is one, and
                                 otherwise walks you through making one and finds the download
                                 in your Downloads folder itself
  --remote NAME                  name of the Drive remote (default: $REMOTE)
  --mount DIR                    where Drive appears (default: $MOUNT)
  --force-reauth                 re-run the Google consent even if the scope already matches
  --help

Run it with no options the first time: one run takes you from nothing to a working remote.
Run it again with --scope drive to turn a read-only installation into one that can write.

rclone asks whether to use a web browser for the consent. Over ssh, answer Y anyway and tunnel
the port it listens on from the machine that has the browser:

    ssh -L 53682:localhost:53682 user@host

The consent then redirects to 127.0.0.1:53682 in your own browser and arrives at rclone through
the tunnel. Answering N instead works too, and rclone prints what to run on the other machine.
USAGE
}

while [ $# -gt 0 ]; do
    case "$1" in
        --scope) SCOPE="${2:-}"; shift 2 ;;
        --scope=*) SCOPE="${1#*=}"; shift ;;
        --client-secret) CLIENT_SECRET="${2:-}"; [ -n "$CLIENT_SECRET" ] && CLIENT_SECRET_GIVEN=yes; shift 2 ;;
        --client-secret=*) CLIENT_SECRET="${1#*=}"; [ -n "$CLIENT_SECRET" ] && CLIENT_SECRET_GIVEN=yes; shift ;;
        --remote) REMOTE="${2:-}"; shift 2 ;;
        --remote=*) REMOTE="${1#*=}"; shift ;;
        --mount) MOUNT="${2:-}"; shift 2 ;;
        --mount=*) MOUNT="${1#*=}"; shift ;;
        --force-reauth) FORCE_REAUTH=yes; shift ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown option: $1 (try --help)" ;;
    esac
done

case "$SCOPE" in
    ""|drive|drive.readonly) ;;
    *) die "--scope must be drive or drive.readonly, not '$SCOPE'" ;;
esac

[ -z "$CLIENT_SECRET" ] && CLIENT_SECRET="$CONF_DIR/client_secret.json"

command -v rclone > /dev/null || die "rclone is not installed (apt install rclone, or rclone.org/install)"

# Check the rclone version HERE, before the Google consent, and refuse rather than warn. Everything
# below this line is ten minutes of somebody's afternoon in the Cloud console, and an unusable
# rclone means the mount will not start at the end of it - which is a miserable place to find out.
#
# The check itself lives in the oursync program, and is called rather than copied. This file used
# to carry its own RCLONE_FLOOR and its own comparison, and when the floor moved to 1.67 this copy
# was left at 1.60: setup ran clean to the end on a stock Mint 22 and only the mount objected. One
# constant, one message, nothing to drift. Sibling first, as `oursync setup` does in reverse, so a
# copy run straight out of a checkout checks itself rather than whichever one is on PATH.
here=$(dirname -- "$(readlink -f -- "$0")")
if [ -x "$here/oursync" ]; then
    oursync_bin="$here/oursync"
else
    oursync_bin=$(command -v oursync 2>/dev/null || true)
fi
if [ -n "$oursync_bin" ]; then
    "$oursync_bin" check-rclone || die "rclone is not usable by OurSync - see above. Nothing has been changed."
else
    note "WARNING: cannot find the oursync program, so the rclone version has not been checked."
fi

mkdir -p -- "$CONF_DIR" "$MOUNT" "$PIN_DIR" "$CACHE_DIR"
chmod 700 "$CONF_DIR"

# ---------------------------------------------------------------------------------------------
# The Drive remote, and the one-time Google setup behind it.
# ---------------------------------------------------------------------------------------------

existing_scope=$(rclone config show "$REMOTE" 2>/dev/null | sed -n 's/^scope = //p')
existing_type=$(rclone config show "$REMOTE" 2>/dev/null | sed -n 's/^type = //p')

if [ -n "$existing_type" ] && [ "$existing_type" != drive ]; then
    die "an rclone remote called '$REMOTE' already exists and is not a Drive remote (type=$existing_type)"
fi

# Resolve what was left unsaid: an existing remote keeps the scope it has, and a new one asks for
# read-write, which is what the product is for.
if [ -z "$SCOPE" ]; then
    if [ -n "$existing_type" ]; then
        SCOPE="${existing_scope:-drive}"
    else
        SCOPE=drive
    fi
fi

read_json_field() {
    sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' -- "$2" | head -1
}

# The Cloud project number behind the remote's client, for links that name the user's own project.
remote_project() {
    [ -n "$oursync_bin" ] || return 0
    "$oursync_bin" client-project "$(rclone config show "$REMOTE" 2>/dev/null | sed -n 's/^client_id = //p')"
}

CONSOLE=https://console.cloud.google.com
# The Cloud project's number, known once there is a client id to read it from. Until then the
# console links carry no ?project= and rely on the console remembering the project just made.
PROJECT=""
CLIENT_ID=""
CLIENT_SECRET_VALUE=""
PICKED=""

intro_notes() {
    cat <<'NOTES'
OurSync ships no OAuth client ID and never will. Seeing a whole Drive needs Google's restricted
"drive" scope, and an application distributing its own client ID with that scope needs OAuth
verification plus an annually renewed third-party security assessment. A client from your own
Google Cloud project falls under Google's personal-use exemption instead: no verification, no
assessment, and an API quota nobody else is sharing.

Five short steps in your browser, then OurSync does the rest in this one run. Each step opens its
page (or prints the link, over ssh or with no display) and waits for you to press Enter.
NOTES
}

# A console link for the user's own project once it is known.
project_url() { # path
    printf '%s/%s%s' "$CONSOLE" "$1" "${PROJECT:+?project=$PROJECT}"
}
enable_api_url() {
    printf '%s/flows/enableapi?apiid=drive.googleapis.com%s' "$CONSOLE" "${PROJECT:+&project=$PROJECT}"
}

open_url() {
    printf '    %s\n' "$1" >&2
    if [ -z "${SSH_CONNECTION:-}" ] && { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; } \
        && command -v xdg-open > /dev/null; then
        (xdg-open "$1" > /dev/null 2>&1 &)
    fi
}

# Reads a line into REPLY. End of input is fatal: there is nobody to answer, and looping on it
# would never end.
pause() { # prompt
    printf '%s' "$1" >&2
    IFS= read -r REPLY || die "no answer - the guided steps need a terminal (or pass --client-secret PATH)"
}

guide_step() { # number title url text
    printf '\nStep %s of 5 - %s\n' "$1" "$2"
    printf '%s\n' "$4"
    open_url "$3"
    pause "  Press Enter when done. "
}

downloads_dir() {
    local dir=""
    command -v xdg-user-dir > /dev/null && dir=$(xdg-user-dir DOWNLOAD 2>/dev/null)
    case "$dir" in ""|"$HOME"|"$HOME/") dir="$HOME/Downloads" ;; esac
    printf '%s\n' "$dir"
}

oursync_client() { # file: the output of `oursync check-client`
    [ -n "$oursync_bin" ] || die "cannot find the oursync program to check the client file with"
    "$oursync_bin" check-client "$1"
}
info_field() { printf '%s\n' "$1" | sed -n "s/^$2=//p"; }

# Is this a usable Desktop app client? On success sets CLIENT_ID, CLIENT_SECRET_VALUE and PROJECT.
# On failure says exactly what is wrong and returns 1; the caller decides whether that is fatal.
validate_client() { # file
    local info kind
    [ -r "$1" ] || { note "cannot read $1"; return 1; }
    info=$(oursync_client "$1") || return 1
    kind=$(info_field "$info" kind)
    CLIENT_ID=$(info_field "$info" client_id)
    PROJECT=$(info_field "$info" project)
    case "$kind" in
        desktop) ;;
        web)
            note "$1 is a Web application client. OurSync needs a Desktop app one: a Web client has no"
            note "loopback redirect, so Google's consent would end in redirect_uri_mismatch."
            note "Create a new client with Application type 'Desktop app' and download its JSON:"
            note "    $(project_url auth/clients/create)"
            return 1 ;;
        *)
            note "$1 is not a Google OAuth client file (no top-level \"installed\" object)."
            note "Download the JSON of a Desktop app client from:"
            note "    $(project_url auth/clients)"
            return 1 ;;
    esac
    CLIENT_SECRET_VALUE=$(read_json_field client_secret "$1")
    if [ -z "$CLIENT_ID" ] || [ -z "$CLIENT_SECRET_VALUE" ]; then
        note "$1 has no client_id/client_secret - download the Desktop app client JSON again."
        return 1
    fi
}

# Choose among the client files in Downloads, newest first, or take a path typed by hand. Sets PICKED.
pick_client() {
    local dir files f index
    dir=$(downloads_dir)
    while :; do
        files=()
        while IFS= read -r f; do
            [ -n "$f" ] && files+=("$f")
        done < <(find "$dir" -maxdepth 1 -type f -name 'client_secret*.json' -printf '%T@ %p\n' 2>/dev/null \
                     | sort -rn | cut -d' ' -f2-)
        if [ "${#files[@]}" -eq 0 ]; then
            note "  No client_secret_*.json in $dir yet."
            pause "  Press Enter to look again, or type the file's path: "
            REPLY=${REPLY/#\~/$HOME}
            if [ -z "$REPLY" ]; then continue; fi
            if [ -r "$REPLY" ]; then PICKED=$REPLY; return 0; fi
            note "  cannot read '$REPLY'"
            continue
        fi
        index=0
        for f in "${files[@]}"; do
            index=$((index + 1))
            printf '  %s) %s   (%s)\n' "$index" "${f##*/}" "$(date -r "$f" '+%Y-%m-%d %H:%M')" >&2
        done
        pause "  Use which? Enter for 1, another number, or type a path: "
        REPLY=${REPLY/#\~/$HOME}
        case "$REPLY" in
            "") PICKED=${files[0]}; return 0 ;;
            *[!0-9]*) if [ -r "$REPLY" ]; then PICKED=$REPLY; return 0; fi
                      note "  cannot read '$REPLY'" ;;
            *) if [ "$REPLY" -ge 1 ] && [ "$REPLY" -le "${#files[@]}" ]; then
                   PICKED=${files[$((REPLY - 1))]}; return 0
               fi
               note "  there is no number $REPLY" ;;
        esac
    done
}

# The guided path: the console steps, then the downloaded file. Sets PICKED to a valid client.
guided_client() {
    intro_notes
    guide_step 1 "a project" "$CONSOLE/projectcreate" "  Give it any name and click Create. Wait for the notification, and check the new project is the
  one selected in the bar at the top."
    guide_step 2 "the consent screen" "$CONSOLE/auth/overview" "  Click \"Get started\". App name: anything. Support email: yours. Audience: External. Contact
  email: yours. Agree, then Create."
    guide_step 3 "publish it, which is what stops the seven-day expiry" "$CONSOLE/auth/audience" "  Click \"Publish app\", then Confirm. No verification is needed, and it removes the need to add
  yourself as a test user. Do NOT add a logo anywhere: an app with one has to be verified."
    guide_step 4 "a Desktop client" "$CONSOLE/auth/clients/create" "  Application type \"Desktop app\", any name, Create. In the box that appears, click \"Download JSON\".
  It lands in your Downloads folder and OurSync will find it there."
    printf '\nLooking for the file you downloaded.\n' >&2
    while :; do
        pick_client
        validate_client "$PICKED" && break
        note "  Pick another, or download it again."
    done
    guide_step 5 "the Drive API" "$(enable_api_url)" "  Click Enable (project ${PROJECT:-?}, the one in your file). If it says \"API enabled\" already,
  there is nothing to do."
}

# Copy the client where setup keeps it, private. The source stays where it was found.
install_client() { # source
    local dest="$CONF_DIR/client_secret.json"
    chmod 600 -- "$1" 2>/dev/null || true
    if [ "$(readlink -f -- "$1")" != "$(readlink -f -- "$dest")" ]; then
        (umask 077; cp -- "$1" "$dest") || die "could not copy the client file to $dest"
    fi
    chmod 600 -- "$dest"
}

# The remote is written into rclone's configuration file directly, not with `rclone config create
# ... client_secret=...`, because that puts the secret in rclone's argument list and every account
# on the machine can read that through ps. The consent itself is `config reconnect`, which takes
# everything from the file.
write_remote() { # name client_id client_secret scope
    local path
    path=$(rclone config file 2>/dev/null | tail -1)
    [ -n "$path" ] || die "cannot find out where rclone keeps its configuration"
    if [ -e "$path" ] && head -n 5 -- "$path" | grep -q 'RCLONE_ENCRYPT_V0'; then
        die "$path is encrypted, and OurSync will not put a client secret on a command line instead. Decrypt it (rclone config encryption remove) for this setup."
    fi
    mkdir -p -- "$(dirname -- "$path")"
    (umask 077; printf '\n[%s]\ntype = drive\nclient_id = %s\nclient_secret = %s\nscope = %s\n' \
        "$1" "$2" "$3" "$4" >> "$path") || die "could not write $path"
}

# One plain sentence and the exact link for each way the first consent or call commonly fails.
# Prints nothing and returns 1 for text it does not recognise.
explain_failure() { # text
    case "$1" in
        *access_denied*)
            note "Google refused: the app is not published and you are not a listed test user."
            note "Click \"Publish app\" at $(project_url auth/audience) and try again. (Adding yourself as a"
            note "test user also works, but Google then expires the token after seven days.)" ;;
        *redirect_uri_mismatch*)
            note "Google refused the redirect: that client is not a Desktop app."
            note "Create a Desktop app client at $(project_url auth/clients/create)." ;;
        *invalid_client*)
            note "Google does not recognise the client: it was deleted, or its secret is wrong."
            note "Create a Desktop app client at $(project_url auth/clients/create)." ;;
        *accessNotConfigured*|*SERVICE_DISABLED*|*"has not been used in project"*)
            note "The Google Drive API is not enabled for this project."
            note "Enable it at $(enable_api_url) and try again." ;;
        *) return 1 ;;
    esac
}

# Run the browser consent, and diagnose what goes wrong. Three tries, because the commonest
# failures are fixed in the browser and then simply tried again.
consent() {
    local attempt=0 log="$CONF_DIR/.consent.log" status
    while :; do
        attempt=$((attempt + 1))
        rclone config reconnect "$REMOTE:" --auto-confirm 2>&1 | tee "$log" >&2
        status=${PIPESTATUS[0]}
        if [ "$status" -eq 0 ]; then rm -f -- "$log"; return 0; fi
        if ! explain_failure "$(cat -- "$log")"; then
            rm -f -- "$log"
            return 1
        fi
        # A wrong client cannot be fixed by retrying with the same one: take it out, so the next
        # run starts from the guided steps instead of reusing it.
        case "$(cat -- "$log")" in
            *redirect_uri_mismatch*|*invalid_client*)
                rm -f -- "$log" "$CONF_DIR/client_secret.json"
                rclone config delete "$REMOTE" > /dev/null 2>&1 || true
                note "Removed that client from OurSync's setup. Run '$PROG' again once you have a new one."
                return 1 ;;
        esac
        rm -f -- "$log"
        [ "$attempt" -lt 3 ] || return 1
        pause "Press Enter to try again. "
    done
}

# One cheap call, to find out now rather than at first mount that the remote works.
verify_remote() {
    local attempt=0 output
    while :; do
        attempt=$((attempt + 1))
        if output=$(rclone about "$REMOTE:" 2>&1); then
            note "Google Drive answered: $REMOTE works."
            return 0
        fi
        explain_failure "$output" || { note "$output"; return 1; }
        [ "$attempt" -lt 3 ] || return 1
        pause "Press Enter to check again. "
    done
}

token_present() { rclone config show "$REMOTE" 2>/dev/null | grep -q '^token = '; }

needs_verify=no

if [ -z "$existing_type" ]; then
    rule
    note "No rclone remote called '$REMOTE' yet."
    if [ "$CLIENT_SECRET_GIVEN" = yes ]; then
        [ -r "$CLIENT_SECRET" ] || die "no OAuth client JSON at $CLIENT_SECRET"
        validate_client "$CLIENT_SECRET" || die "that client file will not do"
        PICKED=$CLIENT_SECRET
    elif [ -r "$CLIENT_SECRET" ]; then
        note "Using the client file already at $CLIENT_SECRET."
        validate_client "$CLIENT_SECRET" || die "that client file will not do"
        PICKED=$CLIENT_SECRET
    else
        guided_client
        pick_is_download=yes
        # Only ever offer to delete a file that was sitting in Downloads, never one typed in from elsewhere.
        case "$PICKED" in "$(downloads_dir)"/*) ;; *) pick_is_download=no ;; esac
    fi
    install_client "$PICKED"
    write_remote "$REMOTE" "$CLIENT_ID" "$CLIENT_SECRET_VALUE" "$SCOPE"
    note "Added remote '$REMOTE' with scope '$SCOPE'. Next is Google's consent, in your browser."
    note "You will see an \"unverified app\" warning: that is expected, the app is yours. Choose"
    note "Advanced, then \"Go to ... (unsafe)\"."
    consent || die "authorising '$REMOTE' failed"
    note "created remote '$REMOTE'"
    needs_verify=yes
    if [ "${pick_is_download:-no}" = yes ] && [ "$PICKED" != "$CONF_DIR/client_secret.json" ]; then
        pause "Delete the copy of the client file in Downloads, now it is kept privately? [Y/n] "
        case "$REPLY" in
            n*|N*) ;;
            *) rm -f -- "$PICKED" ;;
        esac
    fi

elif [ "$existing_scope" != "$SCOPE" ] || [ "$FORCE_REAUTH" = yes ] || ! token_present; then
    rule
    if token_present || [ "$FORCE_REAUTH" = yes ] || [ "$existing_scope" != "$SCOPE" ]; then
        note "Remote '$REMOTE' has scope '${existing_scope:-unset}'; re-authorising it for '$SCOPE'."
        note "Google will ask for consent again, because the permissions being asked for have changed."
    else
        note "Remote '$REMOTE' exists but has no token - an earlier setup stopped before the consent."
    fi
    rule
    PROJECT=$(remote_project)
    # Two steps, and both are needed. The first changes only the configured scope:
    # config_refresh_token=false keeps the existing token, so a failure here leaves a working
    # remote rather than an unusable one. The second replaces the token, which is the only way a
    # scope change takes effect - Google binds the scope to the token, not to the configuration.
    rclone config update "$REMOTE" scope="$SCOPE" config_refresh_token=false --non-interactive \
        > /dev/null 2>&1
    [ "$(rclone config show "$REMOTE" | sed -n 's/^scope = //p')" = "$SCOPE" ] \
        || die "could not set scope '$SCOPE' on '$REMOTE'"
    consent || die "re-authorising '$REMOTE' failed"
    note "re-authorised '$REMOTE' with scope '$SCOPE'"
    needs_verify=yes
else
    note "remote '$REMOTE' already has scope '$SCOPE'"
fi

if [ "$needs_verify" = yes ]; then
    PROJECT=$(remote_project)
    verify_remote || die "'$REMOTE' was authorised but Google Drive would not answer - see above. Run '$PROG' again to retry"
fi

# ---------------------------------------------------------------------------------------------
# The union. Rebuilt every run so a changed pin directory takes effect, which is harmless: it
# holds no credentials of its own, only a reference to the Drive remote.
#
#   <pin dir>:nc   local disk, and ":nc" so nothing is ever *created* here by accident. A pin is
#                  placed deliberately by oursync; a new file written into the mount goes to Drive.
#   search epall   a read takes the first upstream, in configured order, where the path exists -
#                  so the local copy wins and the file is served from disk.
#   action epall   a write to an existing file applies to every upstream holding it, so a pinned
#                  copy cannot silently diverge from the copy in Drive.
# ---------------------------------------------------------------------------------------------

rclone config delete "$UNION" > /dev/null 2>&1 || true
rclone config create "$UNION" union \
    upstreams "$PIN_DIR:nc $REMOTE:" \
    search_policy epall \
    action_policy epall \
    create_policy epmfs \
    --non-interactive > /dev/null || die "could not create the union remote '$UNION'"
note "configured union remote '$UNION'"

if [ ! -e "$CONF" ]; then
    umask 077
    cat > "$CONF" <<CONF_BODY
# OurSync configuration. Shell syntax, sourced by the oursync script.
REMOTE=$REMOTE
UNION=$UNION
MOUNT=$MOUNT
PIN_DIR=$PIN_DIR
CACHE_DIR=$CACHE_DIR
CACHE_MAX_SIZE=20G
CACHE_MAX_AGE=72h

# auto: the mount is read-only exactly when the remote's scope is read-only, so a write fails at
# once rather than part-way through a save. yes/no override it.
READ_ONLY=auto

# How long a closed file waits before being uploaded, so an application that saves repeatedly
# spends one upload rather than five.
WRITE_BACK=10s

# rclone's own --bwlimit syntax, empty for no limit. A single rate (2M) limits both directions;
# rclone also takes a pair and a timetable, documented at rclone.org/docs/#bwlimit-bandwidth-spec.
# Worth setting on a slow uplink: Drive has no delta upload, so every save of a large file spends
# its whole size.
BWLIMIT=

# Control port, used to invalidate the mount's directory cache the moment a pin changes - without
# it a new pin stays invisible until --dir-cache-time expires. Bound to localhost, and given a
# generated password so that a web page cannot POST to it.
RC_ADDR=127.0.0.1:5572
RC_USER=oursync
RC_PASS=$(head -c 24 /dev/urandom | base64 | tr -d '/+=' | head -c 24)
CONF_BODY
    chmod 600 "$CONF"
    note "wrote $CONF"
else
    note "kept existing $CONF"
fi

mode="read-write"
case "$SCOPE" in *readonly*) mode="read-only" ;; esac

cat <<DONE

Set up. Drive will appear at $MOUNT, $mode.

    systemctl --user enable --now oursync-mount.service     # mount it now and at every login
    systemctl --user enable --now oursync-refresh.timer     # keep pinned files up to date
    oursync doctor                                          # check it over

Right-click a file under $MOUNT in Nemo for "Make available offline".
DONE
